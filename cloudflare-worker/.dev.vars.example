# Cloudflare Worker Local Development Variables (.dev.vars)
# Copy this file to .dev.vars for local testing with `wrangler dev`:
#   cp .dev.vars.example .dev.vars
#
# NOTE: .dev.vars is gitignored and must NEVER be committed to Git.
# In production, set the secrets securely via:
#   npx wrangler secret put DISCORD_SUPPORT_WEBHOOK
#   npx wrangler secret put PORTFOLIO_DISCORD_WEBHOOK_URL

DISCORD_SUPPORT_WEBHOOK=https://discord.com/api/webhooks/your_support_webhook_id/your_support_webhook_token
PORTFOLIO_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_portfolio_webhook_id/your_portfolio_webhook_token
ALLOWED_ORIGINS=https://brijesh-verma.github.io
